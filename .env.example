DATABASE_URL=postgresql://babel:CHANGEME@db:5432/babel
HOME_COUNTRY=XX
GLUETUN_API_URL=http://localhost:8000
REQUESTS_PER_SECOND=1.0
IMAGE_ROOT=/data/images
MIN_FREE_BYTES=21474836480

# Telegram alerts. Two events only, both of which a log line will not reach a
# human in time for: the egress IP appearing in HOME_COUNTRY (the crawl stops),
# and free disk dropping below MIN_FREE_BYTES (image capture pauses).
# Leave both blank to log instead of notifying — that is a legitimate choice.
# BOTH values are required. Setting one alone falls back to logging, with a
# warning, because a half-configuration's symptom is silence.
# BOT_TOKEN: talk to @BotFather -> /newbot -> it gives you 123456:ABC-DEF...
# CHAT_ID:   message your new bot once, then open
#            https://api.telegram.org/bot<TOKEN>/getUpdates and read
#            result[0].message.chat.id  (negative for groups)
BOT_TOKEN=
CHAT_ID=

# Gluetun. Fill these in locally; never commit real values.
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=

# Set a real password locally; never commit it. Required — docker-compose.yml
# has no fallback, so an unset value fails loudly instead of defaulting to
# something guessable. Must match the password portion of DATABASE_URL above.
POSTGRES_PASSWORD=
