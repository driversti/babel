DATABASE_URL=postgresql://babel:CHANGEME@db:5432/babel
HOME_COUNTRY=XX
GLUETUN_API_URL=http://localhost:8000
REQUESTS_PER_SECOND=1.0
IMAGE_ROOT=/data/images
MIN_FREE_BYTES=21474836480

# Telegram alerts. Two events only: disk full, and an egress IP in the home
# country. Leave blank to log instead of notifying.
BOT_TOKEN=
CHAT_ID=

# Gluetun. Fill these in locally; never commit real values.
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=

# Set a real password locally; never commit it. Required — docker-compose.yml
# has no fallback, so an unset value fails loudly instead of defaulting to
# something guessable. Must match the password portion of DATABASE_URL above.
POSTGRES_PASSWORD=
