__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.idea/
.vscode/
*.egg-info/
build/
dist/
.env
.env.local
pgdata/
db_data/
# Default IMAGE_ROOT_HOST. The image tree reaches hundreds of GB; it must never
# be committable to a public repo by someone who did not set IMAGE_ROOT_HOST.
data/
# Gluetun's bind mount. Runtime state the container writes itself, including a
# 7 MB server list it regenerates on first start.
gluetun/
.DS_Store

# Database dumps / backups
*.dump
*.sql.gz

# Scraped pages kept locally for inspection.
# Test fixtures live under tests/fixtures/ and ARE committed.
scratch/
*.html
!tests/fixtures/**/*.html
# Jinja templates are source, and the *.html rule above would silently drop them:
# `git add -A` exits 0 without mentioning the file, the suite still passes because
# pythonpath reads the working tree, and the deploy host raises TemplateNotFound
# on every route. Verified with `git check-ignore -v`.
!src/babel/**/*.html
.superpowers/
