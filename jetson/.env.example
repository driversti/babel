# Copy to jetson/.env on the Jetson itself: cp jetson/.env.example jetson/.env
# `docker compose` auto-loads .env from the directory it is run in, which the
# README's Jetson setup already `cd`s into before bringing the service up.

# This machine's own LAN address. jetson/docker-compose.yml binds the embed
# service to 127.0.0.1 by default — deliberately unusable, so forgetting this
# setting fails loudly (the x86 box gets connection refused) instead of
# quietly exposing the service to the whole LAN. Never 0.0.0.0, for the same
# reason the root .env.example's WEB_BIND never is: Docker's published-port
# rules install into the DOCKER chain and bypass the host firewall.
EMBED_BIND=192.168.0.10
